#! /bin/sh

usage="Restore dump database into a container

Usage:
  $(basename "$0") CONTAINER DBDUMP_FILE
  $(basename "$0") -h
"

if [ "$#" -ne 2 ]; then
  echo "$usage" >&2
  exit 1
fi

while getopts ':h:' option; do
  case "$option" in
    h) echo "$usage"
      exit
      ;;
    \?) printf "illegal option: -%s\n" "$OPTARG" >&2
      echo "$usage" >&2
      exit 1
      ;;
  esac
done

echo "🏗  Restore dump $2 in container $1..."

docker exec $1 sh -c 'mkdir -p /dbdumps/' || exit 1

docker cp $2 $1:/dbdumps/latest.dump || exit 1

if docker exec $1 sh -c 'command -v psql >> /dev/null'; then
  docker exec $1 sh -c 'psql -U $POSTGRES_USER "$POSTGRES_DB" < /dbdumps/latest.dump' || exit 1
elif docker exec $1 sh -c 'command -v mariadb >> /dev/null'; then
  docker exec $1 sh -c 'MYSQL_PWD=$MYSQL_PASSWORD mariadb -u $MYSQL_USER "$MYSQL_DATABASE" < /dbdumps/latest.dump' || exit 1
elif docker exec $1 sh -c 'command -v mysql >> /dev/null'; then
  docker exec $1 sh -c 'MYSQL_PWD=$MYSQL_PASSWORD mysql -u $MYSQL_USER "$MYSQL_DATABASE" < /dbdumps/latest.dump' || exit 1
elif docker exec $1 sh -c 'command -v mongorestore >> /dev/null'; then
  docker exec $1 sh -c 'mongorestore --archive=/dbdumps/latest.dump --username=$MONGO_INITDB_ROOT_USERNAME --password=$MONGO_INITDB_ROOT_PASSWORD --authenticationDatabase=admin' || exit 1
else
  echo "❌ Not a supported db"
  exit 1
fi
docker exec $1 sh -c 'rm -rf /dbdumps/' || exit 1

echo "✅ Dump db restored in $1..."
